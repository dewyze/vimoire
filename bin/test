#!/bin/bash
# Run tests using Neovim and plenary test harness

cd "$(dirname "$0")/.."

# Match the dev build's runtime: stdpath must point at the dev data dir
# (~/.local/share/vimoire_dev) so plugins like snacks resolve in headless
# tests, from the same plugin set the dev build runs against.
NVIM_APPNAME=vimoire_dev nvim --headless -u tests/minimal_init.lua -c "lua require('tests.init')"
