#!/usr/bin/env bash
# vimoire launcher: focus the running instance, or cold-launch one.
# Single-instance — one vimoire window ever; re-launching raises it.
#
# A stale socket (left by a crash) HANGS on connect rather than failing,
# so probe with --remote-expr under a manual timeout; macOS has no timeout(1).
set -euo pipefail

# GUI callers (Raycast, Finder) run with a bare PATH that lacks homebrew —
# make neovide/nvim resolve regardless of who launched us.
case ":$PATH:" in
  *:/opt/homebrew/bin:*) ;;
  *) PATH="/opt/homebrew/bin:$PATH" ;;
esac

SOCK=/tmp/vimoire.sock
EDITOR_BIN="${VIMOIRE_EDITOR:-neovide}"

# Self-locate: this file is the source of truth at bin/vimoire in the
# checkout (dev mode — raw neovide exec) and a copy shipped by build-bundle
# at Vimoire.app/Contents/Resources/vimoire (app mode — cold-launch the
# bundle it lives in). Where it wakes up is the mode switch.
SELF_DIR="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
BUNDLE="${SELF_DIR%/Contents/Resources}"
case "$BUNDLE" in
  *.app) [ "$BUNDLE" != "$SELF_DIR" ] || BUNDLE="" ;;
  *) BUNDLE="" ;;
esac

# Dev mode runs the live working tree via its own config root; the
# installed app reads the bin/release copy at ~/.config/vimoire.
if [ -z "$BUNDLE" ]; then
  DEV_XDG="${TMPDIR:-/tmp}/vimoire-dev-xdg"
  mkdir -p "$DEV_XDG"
  ln -sfn "$ROOT/app" "$DEV_XDG/vimoire"
fi

# Resolve the repo root even when invoked through a PATH symlink, so the Dock
# icon is found no matter where the launcher is called from.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [ "${src#/}" = "$src" ] && src="$dir/$src"
done
ROOT="$(cd -P "$(dirname "$src")/.." && pwd)"
ICON="$ROOT/assets/vimoire.icns"

probe() {
  [ -S "$SOCK" ] || return 1
  nvim --server "$SOCK" --remote-expr 1 >/dev/null 2>&1 &
  local pid=$!
  for _ in $(seq 20); do
    if ! kill -0 "$pid" 2>/dev/null; then
      wait "$pid"
      return $?
    fi
    sleep 0.1
  done
  kill "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
  return 1
}

if probe; then
  # Only neovide knows this command; ignore failure under terminal nvim.
  nvim --server "$SOCK" --remote-send '<Cmd>NeovideFocus<CR>' 2>/dev/null || true
else
  rm -f "$SOCK"
  if [ -n "$BUNDLE" ]; then
    # App mode: launch through LaunchServices; init.lua serverstarts the
    # socket, so wait for it, then raise the window.
    open -a "$BUNDLE"
    for _ in $(seq 100); do [ -S "$SOCK" ] && break; sleep 0.1; done
    [ -S "$SOCK" ] || { echo "vimoire didn't start" >&2; exit 1; }
    nvim --server "$SOCK" --remote-send '<Cmd>NeovideFocus<CR>' 2>/dev/null || true
  elif [ "$(basename "$EDITOR_BIN")" = "neovide" ]; then
    exec env NVIM_APPNAME=vimoire XDG_CONFIG_HOME="$DEV_XDG" "$EDITOR_BIN" --icon "$ICON" --fork -- --listen "$SOCK" "$@"
  else
    exec env NVIM_APPNAME=vimoire XDG_CONFIG_HOME="$DEV_XDG" "$EDITOR_BIN" --listen "$SOCK" "$@"
  fi
fi
